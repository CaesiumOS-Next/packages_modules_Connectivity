        "id": 1947461
      },
      "writtenOn": "2023-12-13T11:02:53Z",
      "side": 1,
      "message": "I guess we have this to decrease the frequency of stats write but do we need this?\nDo we have any issue if we don\u0027t have this?",
      "range": {
        "startLine": 161,
        "startChar": 20,
        "endLine": 161,
        "endChar": 44
      },
      "revId": "b26436eeaa4389984068812f7ca6bb1f8699fb05",
