      "lineNbr": 161,
      "author": {
        "id": 1947210
      },
      "writtenOn": "2023-12-13T13:46:51Z",
      "side": 1,
      "message": "There is internal guidance to limit logging rate if atoms are expected to be logged more frequently than once per second. StatsD has abuffer that starts dropping atoms if its capacity is exceeded.",
      "parentUuid": "7227becb_79366021",
      "range": {
        "startLine": 161,
        "startChar": 20,
        "endLine": 161,
        "endChar": 44
      },
      "revId": "b26436eeaa4389984068812f7ca6bb1f8699fb05",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
