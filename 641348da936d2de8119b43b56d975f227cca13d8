      "writtenOn": "2022-03-04T15:30:53Z",
      "side": 1,
      "message": "If you end up using a native array (so you can use wirteIntArray, see comment above), you can use BitUtils#unpackBits.",
      "range": {
        "startLine": 1438,
        "startChar": 0,
        "endLine": 1440,
        "endChar": 9
      },
      "revId": "641348da936d2de8119b43b56d975f227cca13d8",
