      "lineNbr": 1166,
      "author": {
        "id": 1308473
      },
      "writtenOn": "2023-01-18T12:35:29Z",
      "side": 1,
      "message": "No sure we should deprecate `resolveService` because it\u0027s still available for users that want to get service info quickly and no need to unregister any listener I think.",
      "parentUuid": "a22b1538_f0e1d71a",
      "range": {
        "startLine": 1166,
        "startChar": 16,
        "endLine": 1166,
        "endChar": 30
      },
      "revId": "a317e7478b59289c7cb387b03ef632d9553eb0de",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "1f6206b3_11f6a080",
