      "writtenOn": "2023-01-17T09:47:05Z",
      "side": 1,
      "message": "You must have an @IntDef for the error codes.\n\nYou must only send errors that are actionable for the app (if you\u0027re a developer and you see an error you should know what to do). In particular that means you must never send something like INTERNAL_ERROR, because there is nothing the app can do about it.",
      "range": {
        "startLine": 722,
        "startChar": 76,
        "endLine": 722,
        "endChar": 79
      },
      "revId": "a317e7478b59289c7cb387b03ef632d9553eb0de",
