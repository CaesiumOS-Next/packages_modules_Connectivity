      },
      "lineNbr": 199,
      "author": {
        "id": 1015428
      },
      "writtenOn": "2023-01-17T09:47:05Z",
      "side": 1,
      "message": "This would suggest this API subscribes a service to something. It\u0027s not what it does.\n\nInstead, let\u0027s call this registerServiceCallback and unregisterServiceCallback.",
      "range": {
        "startLine": 199,
        "startChar": 23,
        "endLine": 199,
        "endChar": 39
      },
      "revId": "a317e7478b59289c7cb387b03ef632d9553eb0de",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
