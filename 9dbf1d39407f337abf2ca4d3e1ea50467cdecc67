      "writtenOn": "2022-01-07T08:53:22Z",
      "side": 1,
      "message": "How is this different from the existing NetworkCapabilities#hasConnectivityManagedCapability? Could you adapt/rename/reuse that instead of adding this new method here?",
      "range": {
        "startLine": 832,
        "startChar": 23,
        "endLine": 832,
        "endChar": 63
      },
      "revId": "9dbf1d39407f337abf2ca4d3e1ea50467cdecc67",
