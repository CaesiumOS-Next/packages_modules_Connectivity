      "writtenOn": "2023-10-10T11:24:02Z",
      "side": 1,
      "message": "I think TTL is a UINT32, so a signed int won\u0027t fit: it would not be a good API to have users pass in -1, -2 or -3 for the largest values. You\u0027d need to use a long.",
      "range": {
        "startLine": 75,
        "startChar": 12,
        "endLine": 75,
        "endChar": 15
      },
      "revId": "85ddc02816fc96fdad88ee4019d52e287923f354",
