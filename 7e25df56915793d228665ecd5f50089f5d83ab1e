      },
      "writtenOn": "2022-11-17T05:23:40Z",
      "side": 1,
      "message": "if this is used in setUp(), I would suggest removing the function and making the assertion call inline.\n\n(Also, this could live in its own CL).",
      "range": {
        "startLine": 72,
        "startChar": 8,
        "endLine": 72,
        "endChar": 33
      },
      "revId": "7e25df56915793d228665ecd5f50089f5d83ab1e",
