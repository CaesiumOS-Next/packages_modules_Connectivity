    {
      "unresolved": true,
      "key": {
        "uuid": "93cf8713_757b89e7",
        "filename": "tests/cts/net/src/android/net/cts/ConnectivityManagerTest.java",
        "patchSetId": 1
      },
      "lineNbr": 2796,
