      "lineNbr": 246,
      "author": {
        "id": 1148298
      },
      "writtenOn": "2024-01-25T00:28:36Z",
      "side": 1,
      "message": "The new logic is for NetworkRequest with SubscriptionID, although our use case is only for restricted WiFi, but the new logic supports other networks too. getSubIdFromWifiTransportInfo is only for WiFi when SubscriptionID is not set in the network request.\n\nWe only allow 1 subID set in the NetworRequest, so if there are more than 1 subId we won\u0027t use any of them.",
      "parentUuid": "f2368d59_fa705337",
      "range": {
        "startLine": 240,
        "startChar": 0,
        "endLine": 246,
        "endChar": 9
      },
      "revId": "92c671c3b9c309edca6082a5142f7178fb0192fe",
