      "writtenOn": "2024-01-29T21:19:39Z",
      "side": 1,
      "message": "There is one issue with your new proposal, that is isCarrierServiceUidForNetworkCapabilities is also called in NetworkAgentInfo, but we don\u0027t have the flag in NetworkAgentInfo. So I have decided to go with your previous option to pass the mRequestRestrictedWifiEnabled into the constructor of CarrierPrivilegeAuthenticator.",
      "parentUuid": "12c45640_21086f97",
      "range": {
        "startLine": 99,
        "startChar": 67,
        "endLine": 99,
        "endChar": 69
      },
      "revId": "92c671c3b9c309edca6082a5142f7178fb0192fe",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
