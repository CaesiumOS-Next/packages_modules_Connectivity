      "writtenOn": "2024-08-09T06:57:31Z",
      "side": 1,
      "message": "It seems the current netd check for VPN is that we don\u0027t destroy if the there is a VPN with the same address and the same netid.\nI think this code does not check the netid but I\u0027m not sure if difference cause any issue.\n@lorenzo@google.com, Do you know why are we checking the netId in the current netd?",
      "range": {
        "startLine": 14346,
        "startChar": 8,
        "endLine": 14346,
        "endChar": 9
      },
      "revId": "25f63ab451a87c1b1f6efdf85bb520ff954824e7",
