      },
      "writtenOn": "2022-07-26T02:59:51Z",
      "side": 1,
      "message": "Maybe not for this commit. Why do we not to use transport type in NetworkCapabilities to check the network type here?",
      "range": {
        "startLine": 417,
        "startChar": 23,
        "endLine": 417,
        "endChar": 41
      },
      "revId": "857861201b11f7e4e6a991b768406d3b85b89e71",
