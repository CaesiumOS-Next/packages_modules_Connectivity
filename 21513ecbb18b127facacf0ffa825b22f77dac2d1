      "writtenOn": "2022-01-06T10:22:38Z",
      "side": 1,
      "message": "The threading is incorrect. Remember that this code is not running on the same thread as the callbacks. You might receive onCapabilitiesChanged for a network and open the latch, but before the thread blocked in l.609 resumes, there is a call to onAvailable with another network. Then you\u0027ll return the wrong Network object.",
      "range": {
        "startLine": 610,
        "startChar": 23,
        "endLine": 610,
        "endChar": 37
      },
      "revId": "21513ecbb18b127facacf0ffa825b22f77dac2d1",
