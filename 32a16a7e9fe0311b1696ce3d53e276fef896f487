      "writtenOn": "2023-08-25T03:44:17Z",
      "side": 1,
      "message": "Should this be a set instead ? It doesn\u0027t seem to make a lot of sense to have the same prefix twice.",
      "range": {
        "startLine": 82,
        "startChar": 18,
        "endLine": 82,
        "endChar": 27
      },
      "revId": "32a16a7e9fe0311b1696ce3d53e276fef896f487",
