      "lineNbr": 82,
      "author": {
        "id": 1406251
      },
      "writtenOn": "2024-01-09T02:26:02Z",
      "side": 1,
      "message": "updated, two same prefixes with the identical prefix length doesn\u0027t make sense, but given the potential usage (e.g. DHCPv6 PD), I don\u0027t think that may happen, the upstream delegated router should not allocate two same prefixes with the identical prefix length to downstream clients.",
      "parentUuid": "009a5475_2f1dd5e9",
      "range": {
        "startLine": 82,
        "startChar": 18,
        "endLine": 82,
        "endChar": 27
      },
      "revId": "32a16a7e9fe0311b1696ce3d53e276fef896f487",
