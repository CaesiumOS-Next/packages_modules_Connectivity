      "writtenOn": "2021-08-19T00:15:48Z",
      "side": 1,
      "message": "1. Question: IIUC you did not call FullScore#mixInScore given that you are lack of some fields from config?\n\n2. nit: It looks to me this is another variation of mixInScore, maybe name it the same? We can do that when it is really needed, so feel free to ignore.",
      "range": {
        "startLine": 6433,
        "startChar": 16,
        "endLine": 6433,
        "endChar": 62
      },
      "revId": "8240acc2bd5cd18a3164fbd70da4e1c6007a68e3",
