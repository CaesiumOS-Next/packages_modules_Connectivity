      "writtenOn": "2022-12-05T05:48:38Z",
      "side": 1,
      "message": "Can we rename this method to `getReverseAddressName` and let IPv4 can also use this to do the reverse?",
      "range": {
        "startLine": 192,
        "startChar": 12,
        "endLine": 192,
        "endChar": 35
