      "author": {
        "id": 1693933
      },
      "writtenOn": "2023-11-02T05:23:00Z",
      "side": 1,
      "message": "non-static allows you to access fields or methods of outer-class directly without an instance of the outer class",
      "parentUuid": "e144fc30_db234801",
