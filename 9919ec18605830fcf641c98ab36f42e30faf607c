      "writtenOn": "2023-03-15T08:40:52Z",
      "side": 1,
      "message": "This doesn\u0027t seem correct ? The methods are synchronized and it seems this is intended to be used by MdnsServiceTypeClients running on different threads, although they won\u0027t modify the same values (different Network/type)",
      "range": {
        "startLine": 36,
        "startChar": 3,
        "endLine": 36,
        "endChar": 36
      },
      "revId": "9919ec18605830fcf641c98ab36f42e30faf607c",
