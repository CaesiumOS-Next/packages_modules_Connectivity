        "id": 1308473
      },
      "writtenOn": "2023-03-21T05:44:47Z",
      "side": 1,
      "message": "I added the ensureRunningOnHandlerThread() check to all public methods, so it\u0027s thread safe now except the constructor. Update this description accordingly.",
      "parentUuid": "8f7ed33b_c781acf9",
      "range": {
        "startLine": 36,
        "startChar": 3,
        "endLine": 36,
        "endChar": 36
