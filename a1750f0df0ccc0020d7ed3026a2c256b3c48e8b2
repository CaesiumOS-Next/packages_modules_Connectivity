        "id": 1015428
      },
      "writtenOn": "2023-11-21T13:01:30Z",
      "side": 1,
      "message": "I think this needs a little more explanation because you could access nai.linkProperties. Presumably this doesn\u0027t work for you ; you should explain what is the use case. I presume this is because it\u0027s the new link properties ? You could say something like\n\n    * @param nai the nai for which to generate rules\n    * @param nai the link properties of the agent, including possibly the new\n    *            link properties that this agent is about to adopt",
      "range": {
        "startLine": 8798,
        "startChar": 34,
        "endLine": 8798,
        "endChar": 85
      },
      "revId": "a1750f0df0ccc0020d7ed3026a2c256b3c48e8b2",
