      "author": {
        "id": 1000835
      },
      "writtenOn": "2024-10-23T07:09:17Z",
      "side": 1,
      "message": "Right, I don\u0027t think we can remove this, in case OEMs are using it.",
      "parentUuid": "df4fdaff_1aa22a8b",
      "range": {
        "startLine": 13256,
        "startChar": 26,
