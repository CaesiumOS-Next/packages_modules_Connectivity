      "author": {
        "id": 1101726
      },
      "writtenOn": "2024-10-25T23:56:41Z",
      "side": 1,
      "message": "I added a separate config for Wifi. I think we should just experiment with disabling it (setting it to 0).",
      "parentUuid": "de4b0c8e_846af045",
      "range": {
        "startLine": 1968,
        "startChar": 18,
        "endLine": 1968,
        "endChar": 54
      },
      "revId": "dd9ac6f91629a2de28370e4a30209718681180db",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
