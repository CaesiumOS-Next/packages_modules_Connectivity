      "lineNbr": 1968,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2024-10-23T07:09:17Z",
      "side": 1,
      "message": "Can we make this tunable for wifi as well? If we want developers (or the OS) to rely on OnNetworkActiveListener or isDefaultNetworkActive, then we should probably make it work well for wifi too, since in many places devices are on wifi for the majority of the time.\n\nI think the wifi default is 15 seconds, which is both too long (wifi goes back to sleep really quickly after sending a packet) and too short (sending new packets is super cheap).",
      "range": {
        "startLine": 1968,
        "startChar": 18,
        "endLine": 1968,
        "endChar": 54
      },
      "revId": "dd9ac6f91629a2de28370e4a30209718681180db",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
