      "writtenOn": "2024-10-23T07:09:17Z",
      "side": 1,
      "message": "+1 for simplicity here. Other than invalid or values such as 0, we should probably accept whatever is pushed.",
      "parentUuid": "17c1c8e7_8a3a98c7",
      "range": {
        "startLine": 1617,
        "startChar": 54,
        "endLine": 1617,
        "endChar": 60
