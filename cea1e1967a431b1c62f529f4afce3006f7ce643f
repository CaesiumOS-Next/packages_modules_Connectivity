      "writtenOn": "2023-01-10T13:05:21Z",
      "side": 1,
      "message": "Not really, because NsdService would always notify the client of success immediately, not wait for actual unregistration. Added a comment.",
      "parentUuid": "f27c2b55_e9cee5ac",
      "range": {
        "startLine": 295,
