      "writtenOn": "2025-02-25T02:26:30Z",
      "side": 1,
      "message": "Can we find out when this actually happens? It should either be impossible or very rare. Is it during teardown? Or...?",
      "range": {
        "startLine": 910,
        "startChar": 12,
        "endLine": 910,
        "endChar": 25
      },
      "revId": "2e336acd5b9d2cd24086b3f5bab6c3dad57a2090",
