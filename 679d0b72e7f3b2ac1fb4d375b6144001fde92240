      "side": 1,
      "message": "Decide to use new API.",
      "parentUuid": "95867161_c26e3d98",
      "revId": "679d0b72e7f3b2ac1fb4d375b6144001fde92240",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
