      "writtenOn": "2023-02-15T15:10:46Z",
      "side": 1,
      "message": "It seems a bit redundant to have both setEnableStaleDns and setStaleDnsOptions. It seems like just setStaleDnsOptions(@Nullable StaleDnsOptions options) would be sufficient?",
      "range": {
        "startLine": 75,
        "startChar": 54,
        "endLine": 75,
        "endChar": 72
      },
      "revId": "fb4c1af99c74e3e83920e28c39553041c2aba779",
