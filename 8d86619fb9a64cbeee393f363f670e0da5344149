      "writtenOn": "2021-06-17T20:58:30Z",
      "side": 1,
      "message": "Why do we need to change meteredness? The APIs under test take meteredness as an argument and doesn\u0027t actually use the meteredness of the device",
      "range": {
        "startLine": 61,
        "startChar": 8,
        "endLine": 61,
        "endChar": 68
      },
      "revId": "8d86619fb9a64cbeee393f363f670e0da5344149",
