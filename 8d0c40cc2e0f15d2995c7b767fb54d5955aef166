      "writtenOn": "2023-04-14T04:38:13Z",
      "side": 1,
      "message": "Do we really need to start NetLinkMonitor on boot? If the module is installed on the T platform, the NetLinkMonitor will keep tracking address updates even if the new backend is never used. Can we start NetLinkMonitor when it calls startMonitoringSockets()?",
      "range": {
        "startLine": 1335,
        "startChar": 8,
        "endLine": 1335,
        "endChar": 63
      },
      "revId": "8d0c40cc2e0f15d2995c7b767fb54d5955aef166",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
