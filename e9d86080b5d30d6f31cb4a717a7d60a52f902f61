      },
      "writtenOn": "2023-02-17T06:43:55Z",
      "side": 1,
      "message": "If you call something \"callback\" then it will be difficult to add methods to it that call back into the service. I don\u0027t have good suggestions for other names to use here. OffloadProvider? OffloadEngine? ...?",
      "range": {
        "startLine": 328,
        "startChar": 21,
        "endLine": 328,
        "endChar": 44
      },
      "revId": "e9d86080b5d30d6f31cb4a717a7d60a52f902f61",
