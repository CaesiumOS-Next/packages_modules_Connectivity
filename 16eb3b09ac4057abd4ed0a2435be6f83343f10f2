      "writtenOn": "2022-01-24T15:42:18Z",
      "side": 1,
      "message": "nc is already a defensive copy in both codepaths that get here. Do we need this other copy? Are we keeping it just to ensure that equals() won\u0027t return true due to pointer equality even if the object has mutated?",
      "range": {
        "startLine": 7382,
        "startChar": 35,
        "endLine": 7382,
        "endChar": 63
      },
      "revId": "16eb3b09ac4057abd4ed0a2435be6f83343f10f2",
