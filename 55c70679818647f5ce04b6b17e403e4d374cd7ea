        "id": 1000835
      },
      "writtenOn": "2022-03-25T13:40:58Z",
      "side": 1,
      "message": "Why only do this for UDP and not for TCP? It seems like we should do it for all socket types.",
      "range": {
        "startLine": 102,
        "startChar": 12,
        "endLine": 102,
        "endChar": 56
      },
      "revId": "55c70679818647f5ce04b6b17e403e4d374cd7ea",
