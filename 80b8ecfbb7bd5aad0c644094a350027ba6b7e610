    {
      "unresolved": true,
      "key": {
        "uuid": "f5436e1d_e5003ae8",
        "filename": "service/src/com/android/server/ConnectivityService.java",
        "patchSetId": 2
      },
      "lineNbr": 10957,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2022-05-09T07:02:46Z",
      "side": 1,
      "message": "We should at least add a comment that while this code runs, the SettingsObserver inside PermissionMonitor could be changing the list of allowed UIDs. Ideally we should find a way to fix it. Maybe we can ensure that the PermissionMonitor SettingsObserver is registered on the ConnectivityService handler thread? In general it feels like long term, everything in PermissionMonitor should be running on that thread anyway...",
      "range": {
        "startLine": 10957,
        "startChar": 17,
        "endLine": 10957,
        "endChar": 61
      },
      "revId": "80b8ecfbb7bd5aad0c644094a350027ba6b7e610",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "6f44a3e2_dfc290a7",
        "filename": "service/src/com/android/server/ConnectivityService.java",
