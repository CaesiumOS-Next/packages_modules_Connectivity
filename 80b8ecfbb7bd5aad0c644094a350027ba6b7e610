    },
    {
      "unresolved": true,
      "key": {
        "uuid": "7971393a_5c4a8f14",
        "filename": "service/src/com/android/server/connectivity/PermissionMonitor.java",
        "patchSetId": 2
      },
      "lineNbr": 394,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2022-05-09T07:02:46Z",
      "side": 1,
      "message": "Would it be safe to register this observer on the CS handler thread? That way it cannot run at the same time as CS is unregistering the requests caused by the permissions change.\n\nSilly example of how the code you currently have could be incorrect.\n\n1. App loses permission. SettingsObserver fires. We remover the UID from the list and tell CS that the permissions have changed.\n2. App gains permission again. SettingsObserver fires. we add the UID to the list and tell CS that the permission has changed.\n3. CS processes the permission change. It concludes that the app never lost permisison and the request is not unregsitered.\n\nGranted, this is not a big problem. But if the observer runs on the CS handler thread we could prevent it.",
      "range": {
        "startLine": 394,
        "startChar": 16,
        "endLine": 394,
        "endChar": 19
      },
      "revId": "80b8ecfbb7bd5aad0c644094a350027ba6b7e610",
