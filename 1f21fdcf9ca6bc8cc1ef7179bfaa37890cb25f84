            {
              "path": "staticlibs/device/com/android/net/module/util/netlink/NetlinkUtils.java",
              "range": {
                "startLine": 509,
                "startChar": 0,
                "endLine": 509,
                "endChar": 0
              },
              "replacement": "        if (mtu \u003c\u003d 0) {\n            Log.e(TAG, \"MTU value should be greater than 0, but got: \" + mtu);\n            return false;\n        }\n"
            }
          ]
        }
      ],
      "revId": "1f21fdcf9ca6bc8cc1ef7179bfaa37890cb25f84",
