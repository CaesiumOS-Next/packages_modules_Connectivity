      "writtenOn": "2021-12-14T06:11:54Z",
      "side": 1,
      "message": "Can this be static?",
      "range": {
        "startLine": 766,
        "startChar": 12,
        "endLine": 766,
        "endChar": 16
      },
      "revId": "c76c51afe38cdd16643015957e930c3575e6c61d",
