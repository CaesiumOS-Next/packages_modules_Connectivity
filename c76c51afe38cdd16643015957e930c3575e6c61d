      "writtenOn": "2021-12-14T07:48:36Z",
      "side": 1,
      "message": "No, because sendTetherResult (which is used by setBluetoothTetheringSettings) is not static.",
      "parentUuid": "0d20f881_b43b5f3b",
      "range": {
        "startLine": 766,
        "startChar": 12,
        "endLine": 766,
        "endChar": 16
