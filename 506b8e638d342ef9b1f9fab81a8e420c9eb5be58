      "writtenOn": "2024-02-06T07:08:39Z",
      "side": 1,
      "message": "If we use `UserHandle.SYSTEM`, can we receive callback for all users on the device?\nI can see some code passes `UserHandle.ALL` so I\u0027m confirming just in case.",
      "range": {
        "startLine": 72,
        "startChar": 76,
        "endLine": 72,
        "endChar": 82
      },
      "revId": "506b8e638d342ef9b1f9fab81a8e420c9eb5be58",
