      "writtenOn": "2024-01-29T11:16:42Z",
      "side": 1,
      "message": "For the verification of allowedUid update, can we use Network callback?\nThis is a way that usual app can know the network change.\nI think we can do something similar to `testAllowedUids`.",
      "range": {
        "startLine": 17471,
        "startChar": 0,
        "endLine": 17472,
        "endChar": 41
      },
      "revId": "5324ef82b1e087c35547f134013c9e70546ed024",
