      "writtenOn": "2023-05-30T06:36:44Z",
      "side": 1,
      "message": "The error here should also be ERROR_UNSUPPORTED. \nIt is currently SUCCESS, which would cause an onStopped callback when the keepalive is not even started.",
      "range": {
        "startLine": 390,
        "startChar": 57,
        "endLine": 390,
        "endChar": 62
      },
      "revId": "41f78010a7f6d5dba8dbdbbd6f19182cf26f8672",
