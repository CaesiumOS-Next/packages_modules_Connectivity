        "id": 1499410
      },
      "writtenOn": "2023-11-10T17:58:16Z",
      "side": 1,
      "message": "It means we raced with who someone consumed the record after we woke up but we got here. I think this is why the libbpf APIs only implement the consuming polls (those can also race though). Lets return false? since we didn\u0027t get the data.",
      "range": {
        "startLine": 222,
        "startChar": 0,
        "endLine": 223,
        "endChar": 24
      },
      "revId": "78d3f23ac42c1ca79f50d449e4c057d95dcf407a",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
