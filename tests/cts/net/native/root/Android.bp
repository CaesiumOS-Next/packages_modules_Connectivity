// Build the unit tests.

package {
    default_team: "trendy_team_fwk_core_networking",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_test {
    name: "CtsNetNativeRootTestCases",
    test_suites: [
        "cts",
        "general-tests",
    ],
    isolated: false,
    require_root: true,
    defaults: [
        "netd_aidl_interface_lateststable_cpp_static",
        "netd_defaults",
    ],
    tidy: false, // cuts test build time by almost 1 minute
    srcs: [
        "SdkSandboxLocalhostRestrictedTest.cpp",
    ],
    include_dirs: ["system/netd/server"],
    header_libs: ["bpf_headers"],
    shared_libs: [
        "libbase",
        "libnetutils",
        "libutils",
    ],
    static_libs: [
        "libnetd_test_utils",
        "libnettestutils",
        "libflagtest",
        "com.android.net.flags-aconfig-cc",
    ],
    compile_multilib: "both",
    multilib: {
        lib32: {
            suffix: "32",
        },
        lib64: {
            suffix: "64",
        },
    },
    sanitize: {
        address: false,
        recover: ["all"],
    },
}
