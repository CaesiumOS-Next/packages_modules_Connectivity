next_app_data = [ ":CtsHostsideNetworkTestsAppNext" ]

// The above line is put in place to prevent any future automerger merge conflict between aosp,
// downstream branches. The CtsHostsideNetworkTestsAppNext target will not exist in
// some downstream branches, but it should exist in aosp and some downstream branches.





package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "framework-connectivity-module-lib-stubs-dexed-for-test",
    static_libs: [
        "framework-tethering.stubs.module_lib",
        "framework-connectivity.stubs.module_lib",
        "framework-connectivity-t.stubs.module_lib",
    ],
    compile_dex: true,
    visibility: ["//visibility:private"],
}

java_test_host {
    name: "CtsHostsideNetworkTests",
    defaults: ["cts_defaults"],
    // Only compile source java files in this apk.
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    libs: [
        "cts-tradefed",
        "tradefed",
    ],
    static_libs: [
        "kotlin-test",
        "modules-utils-build-testing",
    ],
    // Tag this module as a cts test artifact
    test_suites: [
        "cts",
        "general-tests",
        "sts"
    ],
    data: [
        ":CtsHostsideNetworkTestsApp",
        ":CtsHostsideNetworkTestsApp2",
        ":CtsHostsideNetworkCapTestsAppWithoutProperty",
        ":CtsHostsideNetworkCapTestsAppWithProperty",
        ":CtsHostsideNetworkCapTestsAppSdk33",
        "connectivity-hiddenapi-flags.csv",
        ":framework-connectivity-module-lib-stubs-dexed-for-test"
    ] + next_app_data,
    required: [
        "dexdump"
    ],
    java_resources: [
        // ":com.android.tethering-bootclasspath-fragment{modular-hiddenapi/stub-flags.csv}",
    ],
    per_testcase_directory: true,
}
