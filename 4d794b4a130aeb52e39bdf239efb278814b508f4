      "writtenOn": "2023-09-13T05:03:56Z",
      "side": 1,
      "message": "No, this is not only for test and existing async state machine also behave like this. Here is the use case for ipServer:\n\n                 initial\n               /          \\\n         Tethered      LocalOnly\n             |             |\n        Unavailable     Unavailable\n        \nSince a child state can\u0027t have multiple parent state, Tethered and LocalOnly both have its own Unavailable child which is the same class but different instance.",
      "parentUuid": "1c9e9973_0d4ffa27",
      "range": {
        "startLine": 39,
        "startChar": 11,
        "endLine": 40,
        "endChar": 15
      },
      "revId": "4d794b4a130aeb52e39bdf239efb278814b508f4",
