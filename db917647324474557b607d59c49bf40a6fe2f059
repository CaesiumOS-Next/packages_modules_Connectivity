      "writtenOn": "2023-03-02T10:10:19Z",
      "side": 1,
      "message": "This should probably be called isDefaultNetworkMigrationEnabled. The corresponding setter should be changed to setDefaultNetworkMigrationEnabled.",
      "range": {
        "startLine": 48,
        "startChar": 36,
        "endLine": 48,
        "endChar": 67
      },
