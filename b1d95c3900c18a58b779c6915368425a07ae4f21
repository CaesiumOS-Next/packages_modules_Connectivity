      "lineNbr": 854,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2021-12-28T07:32:06Z",
      "side": 1,
      "message": "Do we need to null out mBluetoothCallback and mBluetoothInterface request here? Or is it expected that when PAN reconnects, tethering will start again?",
      "range": {
        "startLine": 854,
        "startChar": 44,
        "endLine": 854,
        "endChar": 45
      },
      "revId": "b1d95c3900c18a58b779c6915368425a07ae4f21",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
      "key": {
        "uuid": "8df766d3_a7e54c72",
        "filename": "Tethering/src/com/android/networkstack/tethering/Tethering.java",
