      },
      "writtenOn": "2021-12-28T07:32:06Z",
      "side": 1,
      "message": "Do we want to log an error or wtf if onAvailable is called but mConfiguredBluetoothIface is non-null? That would be a bug in bluetooth, right?",
      "range": {
        "startLine": 846,
        "startChar": 12,
        "endLine": 846,
        "endChar": 27
