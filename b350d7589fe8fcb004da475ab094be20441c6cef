    {
      "unresolved": true,
      "key": {
        "uuid": "9ef0d8d0_91543272",
        "filename": "Tethering/tests/unit/src/com/android/networkstack/tethering/BpfCoordinatorTest.java",
        "patchSetId": 5
      },
      "lineNbr": 240,
