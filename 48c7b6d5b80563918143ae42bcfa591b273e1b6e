      "writtenOn": "2022-02-21T01:29:12Z",
      "side": 1,
      "message": "On most phones, this will always return true even if the device does not have a USB-to-Ethernet adapter. Is this what we want here? Should you instead be calling something like EthernetManager#isAvailable?",
      "range": {
        "startLine": 1545,
        "startChar": 20,
        "endLine": 1545,
        "endChar": 39
      },
      "revId": "48c7b6d5b80563918143ae42bcfa591b273e1b6e",
