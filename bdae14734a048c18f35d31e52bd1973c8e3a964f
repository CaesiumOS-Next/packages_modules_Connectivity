        "id": 1000835
      },
      "writtenOn": "2021-04-15T15:20:17Z",
      "side": 1,
      "message": "Get the SSID from NetworkCapabilities instead, because WifiManager#getConnectionInfo will not work well if multiple wifi networks are connected at the same time.",
      "range": {
        "startLine": 1841,
        "startChar": 40,
        "endLine": 1841,
        "endChar": 82
      },
      "revId": "bdae14734a048c18f35d31e52bd1973c8e3a964f",
