    {
      "unresolved": true,
      "key": {
        "uuid": "dc32bb4e_e836708d",
        "filename": "thread/framework/java/android/net/thread/ActiveOperationalDataset.java",
        "patchSetId": 27
      },
      "lineNbr": 204,
      "author": {
        "id": 1015428
      },
      "writtenOn": "2023-10-13T07:02:20Z",
      "side": 1,
      "message": "Let\u0027s make sure this is actually necessary as a public API. This is only necessary if a client of this API reads from the wire. If it\u0027s reading from the cloud or storage or something, the format is by definition proprietary and therefore this is only a convenience API, which should not be part of Android core APIs.",
      "range": {
        "startLine": 204,
        "startChar": 4,
        "endLine": 204,
        "endChar": 10
      },
      "revId": "a6a7d4cbf3b80bcfde01378d02d91fa46ad9eea2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "92b88f40_8cb85693",
        "filename": "thread/framework/java/android/net/thread/ActiveOperationalDataset.java",
        "patchSetId": 27
      },
      "lineNbr": 204,
      "author": {
        "id": 1693933
      },
      "writtenOn": "2023-10-15T09:06:38Z",
      "side": 1,
      "message": "@jonhui@google.com @xyk@google.com Dou you know have any use cases in mind that we need this API to be public? Note that this can be private API to support parsing Active Operational Dataset read from ot-daemon of this device.",
      "parentUuid": "dc32bb4e_e836708d",
      "range": {
        "startLine": 204,
        "startChar": 4,
        "endLine": 204,
        "endChar": 10
      },
      "revId": "a6a7d4cbf3b80bcfde01378d02d91fa46ad9eea2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
