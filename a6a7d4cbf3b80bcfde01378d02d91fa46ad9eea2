      "lineNbr": 204,
      "author": {
        "id": 1501262
      },
      "writtenOn": "2023-10-17T05:49:58Z",
      "side": 1,
      "message": "Not just GMS Core, but some vendor implemented Thread network manager in future, without this API, they have to write code to parse operational dataset if they don\u0027t want to depends on GMS Core. Besides, the ActiveOperationalDataset should be self contained to provide API to convert between binary blob and the object.",
      "parentUuid": "3efe428b_630d27d5",
      "range": {
        "startLine": 204,
        "startChar": 4,
        "endLine": 204,
        "endChar": 10
      },
