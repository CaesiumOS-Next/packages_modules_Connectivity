      "writtenOn": "2023-10-23T03:31:46Z",
      "side": 1,
      "message": "Likely the problem is the same as always : read java spec section 17.5\n\nIf the member is read on another thread, the JVM has no obligation to have the other thread see the assignment, unless the field is final.",
      "range": {
        "startLine": 39,
        "startChar": 0,
        "endLine": 47,
        "endChar": 39
      },
      "revId": "c965e77250655ef1cf701b09032c8af2db076b0b",
