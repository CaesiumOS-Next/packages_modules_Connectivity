    {
      "unresolved": true,
      "key": {
        "uuid": "3ee26561_92c24d6b",
        "filename": "thread/service/java/com/android/server/thread/ScheduleMigrationOperation.java",
        "patchSetId": 43
      },
      "lineNbr": 42,
      "author": {
        "id": 1015428
      },
      "writtenOn": "2023-10-23T03:31:46Z",
      "side": 1,
      "message": "Keep in mind this is subject to the same problem as mReceiver in the previous file. `false` is the default value for a boolean, so you will always see mIsScheduled initialized to false. However, if `onScheduled` is called on one thread and `isScheduled` is called on another thread, you have no synchronization and there is no guarantee that this will return the latest value.\n\nHow you solve this is up to you, but it should be documented. Options are : add synchronization, make sure this is always running on the same thread (either enforce it or leave it to the client and document it)",
      "range": {
        "startLine": 42,
        "startChar": 15,
        "endLine": 42,
        "endChar": 27
      },
      "revId": "c965e77250655ef1cf701b09032c8af2db076b0b",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
