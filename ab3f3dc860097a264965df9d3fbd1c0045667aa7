      "writtenOn": "2023-11-16T04:50:35Z",
      "side": 1,
      "message": "I don\u0027t have a strong opinion on this but are you sure a long doesn\u0027t cut it ? The max value for a long is close to 10 exabytes.",
      "range": {
        "startLine": 144,
        "startChar": 37,
        "endLine": 144,
        "endChar": 47
      },
      "revId": "ab3f3dc860097a264965df9d3fbd1c0045667aa7",
