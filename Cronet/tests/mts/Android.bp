package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_genrule {
    name: "net-http-test-jarjar-rules",
    tool_files: [
        ":NetHttpTestsLibPreJarJar{.jar}",
        "jarjar_excludes.txt",
    ],
    tools: [
        "jarjar-rules-generator",
    ],
    out: ["net_http_test_jarjar_rules.txt"],
    cmd: "$(location jarjar-rules-generator) " +
        "$(location :NetHttpTestsLibPreJarJar{.jar}) " +
        "--prefix android.net.http.internal " +
        "--excludes $(location jarjar_excludes.txt) " +
        "--output $(out)",
}

android_library {
    name: "NetHttpTestsLibPreJarJar",
    srcs: [
        "//external/cronet:cronet_aml_javatests_sources"
    ],
    sdk_version: "module_current",
    min_sdk_version: "30",
    static_libs: [
        "//external/cronet:cronet_aml_api_java",
        "//external/cronet:cronet_testserver_utils",
        "androidx.test.ext.junit",
        "androidx.test.rules",
        "junit",
        "truth",
    ],
    libs: [
        "android.test.base",
        "framework-connectivity.stubs.module_lib",
        "framework-connectivity-t.stubs.module_lib",
        // "framework-tethering-pre-jarjar"
    ],
    lint: { test: true }
}

android_test {
     name: "NetHttpTests",
     defaults: [
        "CronetTestJavaDefaults",
        "mts-target-sdk-version-current",
     ],
     static_libs: [
        "//external/cronet:cronet_aml_java__testing",
        "NetHttpTestsLibPreJarJar",
        "CtsNetHttpTestsLib",
     ],
     jarjar_rules: ":nethttp-test-jarjar-rules",
     jni_libs: ["//external/cronet:cronet_aml_components_cronet_android_cronet_tests__testing"],
     test_suites: [
         "general-tests",
         "mts-tethering",
     ],
}

java_genrule {
    name: "nethttp-test-jarjar-rules",
    tool_files: [
        ":NetHttpTestsLibPreJarJar{.jar}",
        ":CtsNetHttpTestsLib{.jar}",
        "jarjar-excludes.txt",
    ],
    tools: [
        "jarjar-rules-generator",
    ],
    out: ["nethttp_test_jarjar_rules.txt"],
    cmd: "$(location jarjar-rules-generator) " +
        "$(location :NetHttpTestsLibPreJarJar{.jar}) " +
        "$(location :CtsNetHttpTestsLib{.jar}) " +
        "--prefix android.net.connectivity " +
        "--excludes $(location jarjar-excludes.txt) " +
        "--output $(out)",
}


