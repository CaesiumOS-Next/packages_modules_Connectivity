package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_sdk_library {
    name: "framework-cronet",
    defaults: ["framework-module-defaults"],
    srcs: [
        ":cronet_aml_api_sources",
    ],
    libs: [
        "androidx.annotation_annotation",
    ],
    static_libs: [
        "androidx.core_core-nodeps",
        "cronet_aml_java",
    ],
    apex_available: ["com.android.tethering"],
    jarjar_rules: ":cronet-connectivity-jarjar-rules",
    unsafe_ignore_missing_latest_api: true,
    dist_group: "android",
    // cronet is used as a shared library.
    shared_library: true,
    exclude_kotlinc_generated_files: true,
    compile_dex: true,
}

java_genrule {
    name: "cronet-connectivity-jarjar-rules",
    tool_files: [
        ":cronet_aml_java{.jar}",
        "jarjar-excludes.txt",
    ],
    tools: [
        "jarjar-rules-generator",
    ],
    out: ["cronet_connectivity_jarjar_rules.txt"],
    cmd: "$(location jarjar-rules-generator) " +
        "$(location :cronet_aml_java{.jar}) " +
        "--prefix android.net.http.internal " +
        // Make a ":"-separated list. There will be an extra ":" but empty items are ignored.
        "--excludes $(location jarjar-excludes.txt) " +
        "--output $(out)",
    visibility: [
        "//packages/modules/Connectivity/Cronet:__subpackages__",
    ],
}
