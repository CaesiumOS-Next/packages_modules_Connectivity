cc_library {
    name: "libtraffic_controller",
    defaults: ["netd_defaults"],
    srcs: [
        "NetlinkListener.cpp",
        "TrafficController.cpp",
    ],
    header_libs: [
        "bpf_connectivity_headers",
        "bpf_headers",
        "bpf_syscall_wrappers",
    ],
    static_libs: [
        "libbase",
        "libnetdutils",
        "libutils",
        "netd_aidl_interface-lateststable-ndk",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    export_include_dirs: ["include"],
    sanitize: {
        cfi: true,
    },
    apex_available: [
        "com.android.tethering",
    ],
    min_sdk_version: "30",
}

cc_library_shared {
    name: "libtraffic_controller_jni",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wthread-safety",
    ],
    srcs: [
        "jni/*.cpp",
    ],
    header_libs: [
        "bpf_connectivity_headers",
    ],
    static_libs: [
        "libbase",
        "libnetdutils",
        "libutils",
        "libtraffic_controller",
        "netd_aidl_interface-lateststable-ndk",
    ],
    shared_libs: [
        "liblog",
        "libnativehelper",
    ],
    apex_available: [
        "com.android.tethering",
    ],
    min_sdk_version: "30",
}

cc_test {
    name: "traffic_controller_unit_test",
    test_suites: ["device-tests"],
    require_root: true,
    local_include_dirs: ["include"],
    header_libs: [
        "bpf_connectivity_headers",
    ],
    srcs: [
        "TrafficControllerTest.cpp",
    ],
    static_libs: [
        "libbase",
        "libgmock",
        "liblog",
        "libnetdutils",
        "libtraffic_controller",
        "libutils",
        "netd_aidl_interface-lateststable-ndk",
    ],
}
