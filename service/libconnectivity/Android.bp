package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_shared {
    name: "libcom.android.tethering.connectivity",
    srcs: [
        "src/**/*.cpp",
    ],
    sdk_version: "current",
    min_sdk_version: "30",
    static_libs: [
        "connectivity_native_aidl_interface-ndk",
    ],
    export_include_dirs: ["include"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-error=deprecated-declarations",
    ],

    shared_libs: [
        "libbinder_ndk",
    ],
    stubs: {
        symbol_file: "libconnectivity_native.map.txt",
        versions: [
            "current",
        ],
    },
    header_abi_checker: {
        enabled: true,
        symbol_file: "libconnectivity_native.map.txt",
    },
    apex_available: [
        "com.android.tethering",
    ],
}

// Below should be in /vendor, and added to PRODUCT_PACKAGES (b/187806226#comment19)
linker_config {
    name: "test_connectivity_vendor_user_linkerconfig",
    src: "testbinary/vendor.linker.config.json",
    vendor: true,
}

// Below should also be in /vendor and added to PRODUCT_PACKAGES
cc_binary {
    name: "test_connectivity_vendor_user",
    srcs: ["testbinary/**/*.cpp"],
    vendor: true,
    proprietary: true,
    sdk_version: "current",
    shared_libs: [
        "libcom.android.tethering.connectivity",
        "liblog",
    ],
}
