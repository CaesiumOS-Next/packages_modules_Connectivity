//     ],
// }

cc_library_shared {
    name: "libconnectivity_native_llndk",
    srcs: [
        "src/**/*.cpp",
    ],
    sdk_version: "current",
    min_sdk_version: "30",
    static_libs: [
        "connectivity_native_aidl_interface-ndk",
    ],
    export_include_dirs: ["include"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-error=deprecated-declarations",
    ],

    shared_libs: [
        "libbinder_ndk",
    ],
    llndk: {
        symbol_file: "libconnectivity_native.map.txt",
    },
    stubs: {
        symbol_file: "libconnectivity_native.map.txt",
        versions: [
            "33",
        ],
    },
    header_abi_checker: {
        enabled: true,
        symbol_file: "libconnectivity_native.map.txt",
    },
    apex_available: [
        "com.android.tethering",
    ],
}

cc_binary {
    name: "test_connectivity_vendor_user",
    srcs: ["testbinary/**/*.cpp"],
    vendor: true,
    proprietary: true,
    sdk_version: "current",
    shared_libs: [
        "libconnectivity_native_llndk",
        "liblog",
    ],
}
