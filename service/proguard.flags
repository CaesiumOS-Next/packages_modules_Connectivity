
# Keep JNI registered methods
-keep class android.net.connectivity.com.android.net.module.util.TcUtils {
    native <methods>;
}
-keep class android.net.connectivity.com.android.net.module.util.BpfMap {
    native <methods>;
}
-keep class android.net.connectivity.com.android.net.module.util.BpfUtils {
    native <methods>;
}
-keep class com.android.server.BpfNetMaps {
    native <methods>;
}
-keep class com.android.server.connectivity.ClatCoordinator {
    native <methods>;
}
-keep class com.android.server.net.NetworkStatsFactory {
    native <methods>;
}
# Keep classes extending structured message.
-keepclassmembers public class * extends **.com.android.net.module.util.Struct {
    *;
}
