
# Keep JNI registered methods
-keep class android.net.connectivity.com.android.net.module.util.TcUtils { *; }
-keep class android.net.connectivity.com.android.net.module.util.BpfMap { *; }
-keep class android.net.connectivity.com.android.net.module.util.BpfUtils { *; }

# Keep all services
-keep class com.android.server.BpfNetMaps { *; }
-keep class com.android.server.ConnectivityService** { *; }
-keep class com.android.server.IpSecService** { *; }
-keep class com.android.server.NsdService** { *; }
-keep class com.android.server.TestNetworkService** { *; }
-keep class com.android.server.connectivity.ClatCoordinator** { *; }
-keep class com.android.server.connectivity.ConnectivityNativeService** { *; }
-keep class com.android.server.ethernet.EthernetService** { *; }
-keep class com.android.server.nearby.NearbyService** { *; }
-keep class com.android.server.net.NetworkStatsService** { *; }
-keep class com.android.server.net.NetworkStatsFactory** { *; }

-keepclassmembers public class * extends android.net.connectivity.com.android.net.module.util.Struct {
    *;
}
