    },
    {
      "unresolved": false,
      "key": {
        "uuid": "aa596ead_cdecd48d",
        "filename": "Tethering/src/android/net/ip/IpServer.java",
        "patchSetId": 8
      },
      "lineNbr": 1393,
      "author": {
        "id": 1348424
