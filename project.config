
[access]
	inheritFrom = Platform-Packages-Modules-Projects
[project]
	description = Bug: 170293271
[access "^refs/heads/temp_.*"]
	delete = group TMP1
	forgeAuthor = group TMP1
	forgeCommitter = group TMP1
	push = +force group TMP1
	pushMerge = group TMP1
	create = group TMP1
[access "refs/heads/*"]
	label-Global-Approval = +0..+1 group mdb/mainline-prod-approvers
