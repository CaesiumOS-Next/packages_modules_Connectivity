
[access]
	inheritFrom = Platform-Unrestricted-Projects
[project]
	description = Bug: 170293271
[access "^refs/heads/temp_.*"]
	delete = group TMP1
	forgeAuthor = group TMP1
	forgeCommitter = group TMP1
	push = +force group TMP1
	pushMerge = group TMP1
	create = group TMP1
[access "refs/heads/*"]
	label-Global-Approval = +0..+1 group mdb/mainline-prod-approvers
[access "refs/heads/main"]
	label-Autosubmit = +0..+1 group mdb/art-benchmark-service
	label-Code-Review = -1..+1 group mdb/art-benchmark-service
	label-Presubmit-Ready = +0..+1 group mdb/art-benchmark-service
	read = group mdb/art-benchmark-service
[access "refs/for/*"]
	push = group mdb/copybara-git-writers
