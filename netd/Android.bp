cc_library {
    name: "libconn_for_netd",
    version_script: "libconn_for_netd.map.txt",
    stubs: {
        versions: [
            "1",
        ],
        symbol_file: "libconn_for_netd.map.txt",
    },
    defaults: ["netd_defaults"],
    header_libs: [
        "bpf_connectivity_headers",
        "bpf_map_utils",
        "bpf_syscall_wrappers",
    ],
    srcs: [
        "BpfHandler.cpp",
        "ConnectivityForNetd.cpp",
    ],
    static_libs: [
        "libbase",
        "libcutils",
        "libnetdutils",
    ],
    shared_libs: [
        "liblog",
        "libprocessgroup",
    ],
    export_include_dirs: ["include"],
    header_abi_checker: {
        enabled: true,
        symbol_file: "libconn_for_netd.map.txt",
    },
    sanitize: {
        cfi: true,
    },
    apex_available: ["com.android.tethering"],
    min_sdk_version: "30",
}

cc_test {
    name: "libconn_for_netd_unit_test",
    defaults: ["netd_defaults"],
    test_suites: ["device-tests"],
    require_root: true,
    header_libs: [
        "bpf_connectivity_headers",
        "bpf_map_utils",
        "bpf_syscall_wrappers",
    ],
    srcs: [
        "BpfHandlerTest.cpp",
    ],
    static_libs: [
        "libconn_for_netd",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libnetdutils",
    ],
}