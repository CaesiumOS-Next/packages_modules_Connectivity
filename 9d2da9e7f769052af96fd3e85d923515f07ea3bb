        "id": 1984276
      },
      "writtenOn": "2024-01-15T01:37:01Z",
      "side": 1,
      "message": "Is it actually possible? I mean doesn\u0027t ConnectivityService remove network requests after certain TTL?",
      "parentUuid": "6c30f105_25f38799",
      "range": {
        "startLine": 135,
        "startChar": 8,
        "endLine": 135,
        "endChar": 9
