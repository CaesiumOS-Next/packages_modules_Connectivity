      },
      "writtenOn": "2024-01-15T03:03:50Z",
      "side": 1,
      "message": "ConnectivityService does not remove network request unless app asks or app dies.",
      "parentUuid": "03ef97f2_f1525171",
      "range": {
        "startLine": 135,
        "startChar": 8,
        "endLine": 135,
        "endChar": 9
      },
      "revId": "9d2da9e7f769052af96fd3e85d923515f07ea3bb",
