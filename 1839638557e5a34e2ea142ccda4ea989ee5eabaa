      "writtenOn": "2022-01-17T01:37:45Z",
      "side": 1,
      "message": "Running this check here can provide a false sense of security because calling the API with an invalid result will fail, but sending a direct binder transaction or using reflection might succeed.\n\nThere might be some value in running a check here if it increases developer convenience (e.g., throwing an exception, like you did in a previous patchset) but if all this method does is ignore the invalid input, then I think we\u0027re better off not doing this here at all. The service has to ignore invalid input anyway, so we should just move this check to the service where we have the benefit of correct state, running on the right thread, etc.",
      "range": {
        "startLine": 842,
        "startChar": 8,
        "endLine": 842,
        "endChar": 59
      },
      "revId": "1839638557e5a34e2ea142ccda4ea989ee5eabaa",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
