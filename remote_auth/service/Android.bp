package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "remote-auth-service-srcs",
    srcs: ["java/**/*.java"],
}

java_library {
    name: "remote-connectivity-manager",
    srcs: [
        "java/com/android/server/remote_auth/remoteconnectivitymanager/common/Connection.java",
        "java/com/android/server/remote_auth/remoteconnectivitymanager/common/ConnectionInfo.java",
        "java/com/android/server/remote_auth/remoteconnectivitymanager/common/EventListener.java",
        "java/com/android/server/remote_auth/remoteconnectivitymanager/common/Messenger.java",
        "java/com/android/server/remote_auth/remoteconnectivitymanager/primary/ConnectionException.java",
        "java/com/android/server/remote_auth/remoteconnectivitymanager/primary/ConnectivityManager.java",
        "java/com/android/server/remote_auth/remoteconnectivitymanager/primary/DiscoveredDevice.java",
        "java/com/android/server/remote_auth/remoteconnectivitymanager/primary/DiscoveredDeviceReceiver.java",
        "java/com/android/server/remote_auth/remoteconnectivitymanager/primary/DiscoveryFilter.java",
    ],
}

// Main lib for remote_auth services.
java_library {
    name: "service-remote-auth-pre-jarjar",
    srcs: [":remote-auth-service-srcs"],

    defaults: [
        "framework-system-server-module-defaults"
    ],
    libs: [
        "androidx.annotation_annotation",
        "framework-bluetooth",
        "error_prone_annotations",
        "framework-configinfrastructure",
        "framework-connectivity.impl",
        "framework-statsd",
    ],
    static_libs: [
        "androidx.core_core",
        "guava",
        "libprotobuf-java-lite",
        "fast-pair-lite-protos",
        "modules-utils-build",
        "modules-utils-handlerexecutor",
        "modules-utils-preconditions",
        "modules-utils-backgroundthread",
        "presence-lite-protos",
    ],
    sdk_version: "system_server_current",
    // This is included in service-connectivity which is 30+
    // TODO: allow APEXes to have service jars with higher min_sdk than the APEX
    // (service-connectivity is only used on 31+) and use 31 here
    min_sdk_version: "30",

    dex_preopt: {
        enabled: false,
        app_image: false,
    },
    visibility: [
        "//packages/modules/RemoteAuth/apex",
    ],
    apex_available: [
        "com.android.tethering",
    ],
}

genrule {
    name: "statslog-remote-auth-java-gen",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --java $(out) --module remote_auth " +
         " --javaPackage com.android.server.remote_auth.proto --javaClass RemoteAuthStatsLog" +
         " --minApiLevel 33",
    out: ["com/android/server/remote_auth/proto/RemoteAuthStatsLog.java"],
}