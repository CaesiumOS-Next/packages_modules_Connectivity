      "writtenOn": "2023-05-09T03:09:25Z",
      "side": 1,
      "message": "This was discussed at today\u0027s Core Networking / Power sync. @motomuman@google.com could you reinforce our latest position here please?",
      "parentUuid": "61ac182f_1e4267ca",
      "range": {
        "startLine": 2926,
        "startChar": 22,
