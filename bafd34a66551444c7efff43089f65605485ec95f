      "writtenOn": "2024-05-07T14:38:53Z",
      "side": 1,
      "message": "If the value is fetched dynamically, do we need to specify this here as well? Does specifying it here make the test faster to run locally, or make the test pass even if there is no Internet access or...?",
      "range": {
        "startLine": 22,
        "startChar": 8,
        "endLine": 22,
        "endChar": 73
      },
      "revId": "bafd34a66551444c7efff43089f65605485ec95f",
