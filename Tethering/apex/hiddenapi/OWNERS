# These files are only intended to be changed by platform-compat and
# the soong teams.
set noparent

# soong-team@ as the hiddenapi files are tightly coupled with Soong
file:platform/build/soong:/OWNERS

# compat-team@ for changes to hiddenapi files
file:tools/platform-compat:/OWNERS

# Re-wire build approvers through set noparent barrier
per-file Android.bp,Android.mk,CleanSpec.mk,BUILD,BUILD.bazel,*.bp,*.bzl,cargo_embargo.json = mdb/android-build-approvers
per-file **/*.go = mdb/android-build-approvers #{LAST_RESORT_SUGGESTION}
