package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "TetheringHalShimsDefaults",
    sdk_version: "module_current",
    min_sdk_version: "30",
    srcs: [
        "src/com/android/networkstack/tethering/halshim/control/common/**/*.java",
    ],
    static_libs: [
        "androidx.annotation_annotation",
    ],
    apex_available: [
        "//apex_available:platform", // Used by InProcessTethering
        "com.android.tethering",
    ],
}

// HAL Shims to make other parts of tethering module to use HAL without touching any versioned HAL
// code.
java_library {
    name: "TetheringHalCurrentShims",
    defaults: ["TetheringHalShimsDefaults"],
    static_libs: [
        "OffloadControl10Shims",
    ],
    sdk_version: "module_current",
    visibility: [
        "//packages/modules/Connectivity/Tethering",
    ],
    apex_available: [
        "//apex_available:platform", // Used by InProcessTethering
        "com.android.tethering",
    ],
    jarjar_rules: "jarjar-rules.txt",
}

java_library {
    name: "OffloadControl10Shims",
    defaults: ["TetheringHalShimsDefaults"],
    srcs: [
        "src/com/android/networkstack/tethering/halshim/control/v1_0/**/*.java",
    ],
    static_libs: [
        "android.hardware.tetheroffload.control-V1.0-java",
    ],
    visibility: ["//visibility:private"],
}

java_library {
    name: "OffloadControl11Shims",
    defaults: ["TetheringHalShimsDefaults"],
    srcs: [
        "src/com/android/networkstack/tethering/halshim/control/v1_1/**/*.java",
    ],
    static_libs: [
        "OffloadControl10Shims",
        "android.hardware.tetheroffload.control-V1.1-java",
    ],
    visibility: ["//visibility:private"],
}
