<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.mts.tetheringentitlement">

    <protected-broadcast
        android:name="com.android.mts.tetheringentitlement.SILENT_ENTITLEMENT_CHECK" />

    <application android:name=".TetheringEntitlementTestApp"
            android:allowBackup="false"
            android:label="@string/app_label"
            android:usesCleartextTraffic="true">
        <receiver android:name=".EntitlementTestReceiver"
                android:exported="true">
            <intent-filter>
                <action android:name="com.android.mts.tetheringentitlement.SILENT_ENTITLEMENT_CHECK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
