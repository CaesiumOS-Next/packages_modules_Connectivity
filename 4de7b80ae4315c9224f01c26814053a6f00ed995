      "writtenOn": "2023-10-07T00:04:44Z",
      "side": 1,
      "message": "This looks to be something we actually accounted for in the design. I\u0027ve reopened the comment thread on the design doc and we can use the added context from that and continue discussions there.",
      "parentUuid": "e6e253b1_9abbb75f",
      "range": {
        "startLine": 9519,
        "startChar": 8,
        "endLine": 9519,
