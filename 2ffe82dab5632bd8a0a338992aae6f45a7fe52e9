      "writtenOn": "2024-03-12T04:24:17Z",
      "side": 1,
      "message": "Nit: given that 0 is an invalid TTL, it seems better to use 0 here than -1.",
      "range": {
        "startLine": 54,
        "startChar": 41,
        "endLine": 54,
        "endChar": 62
      },
      "revId": "2ffe82dab5632bd8a0a338992aae6f45a7fe52e9",
