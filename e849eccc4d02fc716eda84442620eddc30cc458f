      "writtenOn": "2024-12-09T01:40:56Z",
      "side": 1,
      "message": "The order is exactly flags then change.\nThe `flags` field specifies the new desired state of the network interface flags (`up ? NetlinkConstants.IFF_UP : 0`) while `change` is the fields we want to modify.(`NetlinkConstants.IFF_UP`)\nThis also indicates that it might be better to use `add_flags` and `removes_flags` as we discussed in former patch to reduce confusion.",
      "parentUuid": "e654390c_3a494002",
      "range": {
        "startLine": 1004,
        "startChar": 16,
        "endLine": 1004,
        "endChar": 73
      },
      "revId": "e849eccc4d02fc716eda84442620eddc30cc458f",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
