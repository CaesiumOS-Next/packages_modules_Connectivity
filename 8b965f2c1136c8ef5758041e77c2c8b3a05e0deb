      "writtenOn": "2022-07-29T22:27:24Z",
      "side": 1,
      "message": "Requiring a dst port is not correct though. This will break use cases where dst port is not set, and future use cases for other protocols where there is no port.",
      "parentUuid": "3f18ab1b_479df03e",
      "range": {
        "startLine": 190,
        "startChar": 12,
