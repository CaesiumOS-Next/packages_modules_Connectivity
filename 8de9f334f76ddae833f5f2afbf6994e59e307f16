      "writtenOn": "2022-03-15T13:50:55Z",
      "side": 1,
      "message": "API methods need docstrings explaining what the API does and how to use it. See:\n\nhttps://android.googlesource.com/platform/developers/docs/+/refs/heads/master/api-guidelines/index.md#docs",
      "range": {
        "startLine": 5871,
        "startChar": 0,
        "endLine": 5873,
        "endChar": 7
      },
      "revId": "8de9f334f76ddae833f5f2afbf6994e59e307f16",
