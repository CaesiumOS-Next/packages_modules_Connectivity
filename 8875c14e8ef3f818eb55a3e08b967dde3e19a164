      "writtenOn": "2025-03-13T07:26:32Z",
      "side": 1,
      "message": "If hotspot restarts \"by itself\", then there is no longer a request here, neither pending nor serving. If in this moment an app calls startTethering, then what happens? Will it just fail?",
      "range": {
        "startLine": 1593,
        "startChar": 20,
        "endLine": 1593,
        "endChar": 40
      },
      "revId": "8875c14e8ef3f818eb55a3e08b967dde3e19a164",
