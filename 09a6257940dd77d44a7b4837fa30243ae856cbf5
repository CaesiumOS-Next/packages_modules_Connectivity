      "key": {
        "uuid": "b3ff4b38_53b4c93a",
        "filename": "framework/src/android/net/ConnectivityManager.java",
        "patchSetId": 4
      },
      "lineNbr": 5023,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2024-12-19T00:59:27Z",
      "side": 1,
      "message": "If the system determines that the requested reservation can never be fulfilled, {@link NetworkCallback#onUnavailble} is called, the reservation is be released by the system, and the provided callback can be reused. Otherwise, the reservation remains in place until the requested network connects. There is no guarantee that the reserved network will ever connect.",
      "range": {
        "startLine": 5023,
        "startChar": 5,
        "endLine": 5023,
        "endChar": 6
      },
      "revId": "09a6257940dd77d44a7b4837fa30243ae856cbf5",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
